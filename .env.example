# ─── Servidor API ────────────────────────────────────────────────
PORT=4000
# 0.0.0.0 = accesible desde otros equipos de tu red local; 127.0.0.1 = solo este PC
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Fuente de datos ─────────────────────────────────────────────
# simulator : aviones simulados (para desarrollar sin antena)
# readsb    : lee aircraft.json de readsb / dump1090-fa / tar1090 (recomendado)
# sbs       : se conecta por TCP al puerto SBS/BaseStation (30003) de cualquier dump1090
SOURCE=simulator

READSB_URL=http://127.0.0.1:8080/data/aircraft.json
READSB_POLL_MS=1000

SBS_HOST=127.0.0.1
SBS_PORT=30003

# Número de aviones del simulador
SIM_AIRCRAFT=30

# ─── Receptor (posición de TU antena) ────────────────────────────
# Valores iniciales; luego se pueden cambiar desde la web o PATCH /api/settings
# (se guardan en data/settings.json y tienen prioridad sobre estos).
RECEIVER_LAT=4.7016
RECEIVER_LON=-74.1469
# Radio de detección inicial en km (presets en la UI: 3, 5, 8, 15, 20, 30)
RADIUS_KM=15

# ─── Seguimiento ─────────────────────────────────────────────────
BROADCAST_MS=1000
# Segundos sin mensajes para eliminar un avión
AIRCRAFT_TIMEOUT_S=60
# Segundos sin posición nueva para considerarla obsoleta (sale del radio)
POSITION_STALE_S=30

# ─── Seguridad / integración ─────────────────────────────────────
# Si se define, PATCH /api/settings exige: Authorization: Bearer <API_TOKEN>
API_TOKEN=
# Orígenes CORS permitidos para consumir la API desde otras apps ("*" = todos)
CORS_ORIGIN=*
